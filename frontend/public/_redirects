# Cloudflare Pages redirects — ported from the `redirects` block in firebase.json.
#
# Replaces a stale Create React App catch-all (`/*  /index.html  200`) that
# predates the move to Next.js. That rule must not come back: `output: 'export'`
# emits a real HTML file per route, and rewriting everything to the SPA shell
# would serve the same empty document for all ~700 exam pages, which is what
# Google indexes. Unmatched paths should fall through to Next's own 404.html.
#
# Format: <from> <to> <status>. First match wins. Keep in sync with the
# category list in src/views/Exams.jsx.

